{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Game Worker: serves the game. No required bindings, so importing this repo
  // into Cloudflare (root directory "/") always deploys.
  "name": "multiplayer-relax",
  "main": "hub/src/index.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./hub/public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }

  // Multiplayer + browser come from other Workers through Service Bindings and
  // are detected automatically. Add them in the dashboard
  // (Settings → Bindings → Add → Service binding), or here so they survive
  // every Git build (the target Workers must already exist):
  //
  // , "services": [
  //   { "binding": "MULTIPLAYER", "service": "relax-multiplayer" },
  //   { "binding": "BROWSER_SVC", "service": "relax-browser" }
  // ]
}
